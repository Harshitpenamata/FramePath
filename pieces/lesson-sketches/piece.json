    "kit/core.js",
    "style",
    "src/scenes.js",
    "src/scenes-intermediate.js",
    "src/scenes-advanced.js",
    "src/scenes-ai-ps.js",
    "src/scenes-style.js",
    "src/timeline.js",
    "src/bridges.js",
    "kit/morph.js",
    "kit/board.js",
    "kit/score-head.js",
    "src/score.js",
    "kit/score-tail.js"
  ]
}
